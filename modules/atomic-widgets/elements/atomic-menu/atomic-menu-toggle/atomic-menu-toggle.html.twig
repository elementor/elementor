{% import 'elementor/macros' as m %}
{%- set classes = ['elementor-element', 'elementor-element-' ~ id, 'e-con', 'e-atomic-element', base_styles.base, m.default_tag_class('button')] | merge(settings.classes | default([])) | join(' ') -%}
{%- set custom_label = settings.attributes is defined and settings.attributes is not empty and 'aria-label=' in settings.attributes -%}
<button type="button" class="{{ classes }} {{ editor_classes | default('') }}"
	{{- ' ' }}{{ m.render_data_attributes(id, type, interaction_id) }}
	{{- ' ' }}x-bind="toggle"
	{%- if custom_label %} data-e-custom-label="true"{% else %} aria-label="{{ settings['label-open'] | default('Open menu') | e('html_attr') }}" data-e-label-open="{{ settings['label-open'] | default('Open menu') | e('html_attr') }}" data-e-label-close="{{ settings['label-close'] | default('Close menu') | e('html_attr') }}"{% endif %}
	aria-expanded="false"
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	<!-- elementor-children-placeholder -->
</button>
