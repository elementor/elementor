{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://elementor.com/schemas/composite-widgets/widget-definition.schema.json",
	"title": "Elementor V4 widget definition",
	"description": "Shape of a V4 widget definition, shared by the code provider (native and third-party) and the site provider (MCP). Cross-reference rules (unique parts, targets that exist, allowed part types, the global-reference rule) are enforced by the PHP validator, not by this schema.",
	"type": "object",
	"required": [ "id", "version", "title", "template", "general" ],
	"additionalProperties": false,
	"properties": {
		"id": { "$ref": "#/definitions/widgetId" },
		"version": {
			"type": "integer",
			"minimum": 1,
			"description": "Bumped by the author when parts or fields change in a way that matters. Every instance records the version it was dropped from."
		},
		"source": {
			"type": "string",
			"enum": [ "code", "site" ],
			"description": "Which provider registered the definition."
		},
		"title": { "$ref": "#/definitions/nonEmptyString" },
		"icon": { "$ref": "#/definitions/nonEmptyString" },
		"category": { "$ref": "#/definitions/nonEmptyString" },
		"detachable": { "type": "boolean" },
		"template": { "$ref": "#/definitions/templateNode" },
		"general": {
			"type": "array",
			"items": {
				"oneOf": [
					{ "$ref": "#/definitions/generalSection" },
					{ "$ref": "#/definitions/repeater" }
				]
			}
		},
		"style": { "$ref": "#/definitions/style" },
		"part_renames": {
			"type": "object",
			"description": "Per older instance version, a map of old part name to new part name, so the panel still finds atoms in copies dropped from that version.",
			"patternProperties": {
				"^[1-9][0-9]*$": {
					"type": "object",
					"patternProperties": {
						"^[a-z][a-z0-9_]*$": { "$ref": "#/definitions/partName" }
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		}
	},
	"definitions": {
		"nonEmptyString": {
			"type": "string",
			"minLength": 1
		},
		"widgetId": {
			"type": "string",
			"pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
			"description": "Namespaced widget ID, for example elementor/pricing-card or site/promo-button."
		},
		"partName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"elementTypeName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*$"
		},
		"localStyleId": {
			"type": "string",
			"pattern": "^local-[a-z][a-z0-9_]*$",
			"description": "Placeholder local style ID: local-<part>. The insert step remaps it to e-{newElementId}-{hash}."
		},
		"propValue": {
			"type": "object",
			"required": [ "$$type", "value" ],
			"properties": {
				"$$type": { "$ref": "#/definitions/nonEmptyString" }
			}
		},
		"templateNode": {
			"type": "object",
			"description": "An element in the template tree. Any element-level key the element itself accepts passes through to the element's own save and sanitize pipeline. Element IDs and the widget marker are not part of a template: IDs are generated and the marker is stamped on insert.",
			"required": [ "elType" ],
			"properties": {
				"elType": { "$ref": "#/definitions/elementTypeName" },
				"widgetType": { "$ref": "#/definitions/elementTypeName" },
				"part": { "$ref": "#/definitions/partName" },
				"slot": {
					"type": "boolean",
					"description": "Open slot: the node's children are regular elements outside the widget's closed structure. Only on a container part below the root."
				},
				"settings": {
					"type": "object",
					"additionalProperties": { "$ref": "#/definitions/propValue" }
				},
				"styles": {
					"type": "object",
					"patternProperties": {
						"^local-[a-z][a-z0-9_]*$": { "$ref": "#/definitions/localStyle" }
					},
					"additionalProperties": false
				},
				"elements": {
					"type": "array",
					"items": { "$ref": "#/definitions/templateNode" }
				}
			},
			"anyOf": [
				{
					"properties": { "elType": { "enum": [ "widget" ] } },
					"required": [ "widgetType" ]
				},
				{
					"properties": { "elType": { "not": { "enum": [ "widget" ] } } },
					"not": { "required": [ "widgetType" ] }
				}
			],
			"not": {
				"anyOf": [
					{ "required": [ "id" ] },
					{ "required": [ "widget" ] }
				]
			}
		},
		"localStyle": {
			"type": "object",
			"required": [ "id", "type", "label", "variants" ],
			"properties": {
				"id": { "$ref": "#/definitions/localStyleId" },
				"type": { "type": "string", "enum": [ "class" ] },
				"label": { "type": "string", "enum": [ "local" ] },
				"variants": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [ "meta", "props" ],
						"properties": {
							"meta": {
								"type": "object",
								"required": [ "breakpoint", "state" ],
								"properties": {
									"breakpoint": { "$ref": "#/definitions/nonEmptyString" },
									"state": { "type": [ "string", "null" ] }
								}
							},
							"props": {
								"type": "object",
								"additionalProperties": { "$ref": "#/definitions/propValue" }
							}
						}
					}
				}
			}
		},
		"target": {
			"type": "object",
			"required": [ "part", "prop" ],
			"additionalProperties": false,
			"properties": {
				"part": { "$ref": "#/definitions/partName" },
				"prop": { "$ref": "#/definitions/nonEmptyString" }
			}
		},
		"partReference": {
			"type": "object",
			"required": [ "part" ],
			"additionalProperties": false,
			"properties": {
				"part": { "$ref": "#/definitions/partName" }
			}
		},
		"field": {
			"type": "object",
			"required": [ "label", "target" ],
			"additionalProperties": false,
			"properties": {
				"label": { "$ref": "#/definitions/nonEmptyString" },
				"target": { "$ref": "#/definitions/target" },
				"removable": {
					"description": "true makes the target part removable; an object names another part to remove.",
					"oneOf": [
						{ "type": "boolean" },
						{ "$ref": "#/definitions/partReference" }
					]
				}
			}
		},
		"fieldGroup": {
			"type": "object",
			"required": [ "label", "fields" ],
			"additionalProperties": false,
			"properties": {
				"label": { "$ref": "#/definitions/nonEmptyString" },
				"removable": { "$ref": "#/definitions/partReference" },
				"fields": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/definitions/field" }
				}
			}
		},
		"generalSection": {
			"type": "object",
			"required": [ "section", "fields" ],
			"additionalProperties": false,
			"properties": {
				"section": { "$ref": "#/definitions/nonEmptyString" },
				"fields": {
					"type": "array",
					"minItems": 1,
					"items": {
						"oneOf": [
							{ "$ref": "#/definitions/field" },
							{ "$ref": "#/definitions/fieldGroup" }
						]
					}
				}
			}
		},
		"repeater": {
			"type": "object",
			"required": [ "repeater", "label", "item", "container", "item_fields" ],
			"additionalProperties": false,
			"properties": {
				"repeater": { "$ref": "#/definitions/partName" },
				"label": { "$ref": "#/definitions/nonEmptyString" },
				"item": { "$ref": "#/definitions/partName" },
				"container": { "$ref": "#/definitions/partName" },
				"item_label": { "$ref": "#/definitions/target" },
				"item_fields": {
					"type": "array",
					"items": { "$ref": "#/definitions/field" }
				},
				"list_fields": {
					"type": "array",
					"items": { "$ref": "#/definitions/field" }
				},
				"prototype": { "$ref": "#/definitions/templateNode" },
				"min": { "type": "integer", "minimum": 0 },
				"max": { "type": "integer", "minimum": 1 }
			}
		},
		"style": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"appearance": {
					"type": "array",
					"items": { "$ref": "#/definitions/preset" }
				},
				"quick_edit": {
					"type": "array",
					"items": { "$ref": "#/definitions/quickEdit" }
				}
			}
		},
		"preset": {
			"type": "object",
			"required": [ "id", "label", "options" ],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/definitions/partName" },
				"label": { "$ref": "#/definitions/nonEmptyString" },
				"options": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/definitions/presetOption" }
				}
			}
		},
		"presetOption": {
			"type": "object",
			"required": [ "id", "label", "set" ],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/definitions/partName" },
				"label": { "$ref": "#/definitions/nonEmptyString" },
				"set": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/definitions/presetWrite" }
				}
			}
		},
		"presetWrite": {
			"type": "object",
			"required": [ "part", "style" ],
			"additionalProperties": false,
			"properties": {
				"part": { "$ref": "#/definitions/partName" },
				"style": {
					"type": "object",
					"description": "Breakpoint name to style props (style-schema keys to PropValues). Written to the part's local style at that breakpoint, normal state.",
					"minProperties": 1,
					"patternProperties": {
						"^[a-z][a-z_]*$": {
							"type": "object",
							"minProperties": 1,
							"patternProperties": {
								"^[a-z][a-z-]*$": { "$ref": "#/definitions/propValue" }
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				}
			}
		},
		"quickEdit": {
			"type": "object",
			"required": [ "label", "style_prop", "targets" ],
			"additionalProperties": false,
			"properties": {
				"label": { "$ref": "#/definitions/nonEmptyString" },
				"style_prop": {
					"type": "string",
					"pattern": "^[a-z][a-z-]*$"
				},
				"targets": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/definitions/partName" }
				}
			}
		}
	}
}
